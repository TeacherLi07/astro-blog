---
import { getImage } from "astro:assets";

interface Props {
  title: string;
  subTitle: string;
  description: readonly string[];
  imageLightSrc: ImageMetadata | null;
  imageDarkSrc: ImageMetadata | null;
}

const { title, subTitle, description, imageLightSrc, imageDarkSrc } = Astro.props;
const resolvedLightImage = imageLightSrc ?? imageDarkSrc;
const resolvedDarkImage = imageDarkSrc ?? imageLightSrc;
const hasThemeVariants = Boolean(
  resolvedLightImage && resolvedDarkImage && resolvedLightImage.src !== resolvedDarkImage.src,
);
const imageClass = "absolute inset-0 size-full object-cover object-[66%_center] tablet:object-[center_48%]";
const optimizedLightImage = resolvedLightImage ? await getImage({ src: resolvedLightImage }) : null;
const optimizedDarkImage = resolvedDarkImage ? await getImage({ src: resolvedDarkImage }) : null;
---

<section
  class="relative flex min-h-[30.625rem] items-end overflow-hidden rounded-panel border border-border/75 bg-hero after:absolute after:inset-0 after:bg-hero-mobile after:content-[''] tablet:min-h-112 tablet:items-center tablet:after:bg-hero-wide"
  aria-labelledby="hero-title"
  data-hero
>
  {
    optimizedLightImage && (
      <>
        <img
          class:list={[imageClass, hasThemeVariants ? "hero-image-light" : "hero-image"]}
          data-hero-image="light"
          data-hero-src={optimizedLightImage.src}
          width={resolvedLightImage?.width}
          height={resolvedLightImage?.height}
          alt=""
          decoding="async"
          fetchpriority="high"
        />
        {hasThemeVariants && optimizedDarkImage && (
          <img
            class:list={[imageClass, "hero-image-dark"]}
            data-hero-image="dark"
            data-hero-src={optimizedDarkImage.src}
            width={resolvedDarkImage?.width}
            height={resolvedDarkImage?.height}
            alt=""
            decoding="async"
          />
        )}
      </>
    )
  }
  <div class="relative z-10 w-full px-6 py-8 tablet:w-3/5 tablet:px-[6.8%] tablet:py-15">
    <h1 class="m-0 font-extrabold text-hero text-text tablet:text-hero-wide" id="hero-title">
      <span
        class="relative inline bg-title-highlight bg-[length:100%_0.4375rem] bg-[position:0_93%] bg-no-repeat tablet:inline-block tablet:bg-none tablet:after:absolute tablet:after:bottom-2 tablet:after:left-0 tablet:after:-z-10 tablet:after:h-2 tablet:after:w-full tablet:after:rounded-panel tablet:after:bg-coral/60 tablet:after:content-['']"
        >{title}</span
      >
    </h1>
    <p class="mt-2 mb-0 text-4xl leading-normal font-bold text-text tablet:mt-3">{subTitle}</p>
    <p class="mt-5 mb-0 max-w-lg text-sm leading-7 text-text-soft tablet:mt-6 tablet:max-w-2xl tablet:text-lg">
      {
        description.map((line, index) => (
          <>
            {line}
            {index < description.length - 1 && <br />}
          </>
        ))
      }
    </p>
  </div>
</section>

<script>
  import "@/scripts/heroThemeLoader";
</script>
