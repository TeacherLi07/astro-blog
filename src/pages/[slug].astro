---
import AboutPage from "@/components/layout/AboutPage.astro";
import { aboutConfig } from "@/config/aboutConfig";
import { getEntry, render } from "astro:content";

export function getStaticPaths() {
  if (!aboutConfig.enabled) {
    return [];
  }

  return [{ params: { slug: "about" } }];
}

const page = await getEntry("pages", "about");

if (!page) {
  throw new Error("Missing content entry: src/content/pages/about.md");
}

const { Content } = await render(page);
---

<AboutPage title={page.data.title} description={page.data.description}>
  <Content />
</AboutPage>
